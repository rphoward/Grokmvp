flowchart LR
  subgraph Steering["Project Steering"]
    AG["AGENTS.md<br/>project boundaries +<br/>physical layer constraints +<br/>active run pointer"]
    CI["docs/context-index.md<br/>fresh-session read order"]
  end

  subgraph Contracts["Router/Planner Contracts"]
    RM["README.md<br/>local contract authority"]
    UN["codex-router-planner-unified.md<br/>v4 unified contract:<br/>router, phase tier, slice tier,<br/>architecture gates, closeout,<br/>project_layer_mapping,<br/>project_shape"]
    SC["codex-extraction-packet-schema-sexpr.md<br/>v4 packet fields:<br/>slice_type, resolution_id, decision_id,<br/>project_shape, project_layer_mapping,<br/>blocking_items_resolution_log"]
    DA["domain-spoke-architecture.md<br/>conceptual architecture rule set<br/>(unchanged in v4)"]
  end

  subgraph PhaseMap["Phase Map (multi_phase only)"]
    PM["docs/phase-map/PHASE-MAP.md<br/>required_outcomes,<br/>non_negotiable_intent,<br/>constraints, deferred_phases<br/><br/>SKIPPED for single_phase projects"]
  end

  subgraph Run["Selected RUN_DIR"]
    ST["STATUS.md<br/>current_mode, active_slice_file,<br/>next_action,<br/>project_shape (single_phase|multi_phase),<br/>closeout_validation:<br/>– blocking_items_resolution_log<br/>– deferrals<br/>– classification_to_implementation_trace"]
    SL["SLICE-LIST.md<br/>approved work queue<br/>+ slice_type per entry<br/>+ project_shape<br/>+ phase_intent (single_phase only)"]
    NX["NEXT-SLICE.md<br/>one task or reviewed handoff<br/>+ slice_type<br/>+ resolution_id (if corrective)<br/>+ decision_id (if architecture_decision)<br/>+ allowed/forbidden_edits (physical names)"]
    PL["PROOF-LOG.md<br/>review-owned proof records<br/>+ slice_type<br/>+ status (passed_closing | passed_with_debt)<br/>+ resolution_id (corrective)<br/>+ decision_id (architecture_decision)"]
    PB["PHASE-BACKLOG.md<br/>optional or explicitly deferred work"]
    AR["archive/*.md<br/>reviewed old NEXT-SLICE handoffs"]
  end

  subgraph Source["Planning Source"]
    SP["source_packet<br/>active_local_source<br/>vs historical_external_evidence"]
    PR["prior_closeout<br/>STATUS + PROOF-LOG + PHASE-BACKLOG<br/>+ closeout_validation.blocking_items_resolution_log"]
  end

  subgraph External["Historical External Evidence"]
    HE["external source repo paths<br/>historical evidence only<br/>unless user explicitly requests reinspection"]
  end

  AG --> ST
  AG -. "physical layer constraints feed project_layer_mapping" .-> UN
  CI --> ST
  RM --> UN
  RM --> SC
  RM --> DA
  UN --> SC
  DA -. "conceptual ownership rules used by planner" .-> UN

  PM --> UN
  PM -. "required_outcomes primary authority at closeout (multi_phase)" .-> ST
  PM -. "deferred_phases drives phase_sealed vs project_complete" .-> ST
  SL -. "phase_intent primary authority at closeout (single_phase)" .-> ST

  ST --> UN
  SL --> UN
  NX --> UN
  PL --> UN

  UN --> ST
  UN --> SL
  UN --> NX
  UN --> PL
  UN --> PB
  UN --> AR

  SP --> UN
  PR --> UN

  PL -. "resolution_id (corrective + passed_closing/with_debt) marks blocking_items_resolution_log entry resolved" .-> ST
  PL -. "decision_id (architecture_decision + passed_closing/with_debt) consulted by ownership_change_gate" .-> UN
  ST -. "project_shape drives phase_state_derivation: phase_sealed vs project_complete" .-> UN
  PB -. "blocking → required; optional → may defer" .-> ST
  HE -. "not active dependency by default" .-> SP

  classDef steering fill:#eaf4ff,stroke:#1f6fb2,color:#0f172a,stroke-width:2px;
  classDef contracts fill:#ecfdf5,stroke:#15803d,color:#0f172a,stroke-width:2px;
  classDef phasemap fill:#fef3c7,stroke:#a16207,color:#0f172a,stroke-width:2px,stroke-dasharray:5 5;
  classDef run fill:#fff4df,stroke:#b7791f,color:#0f172a,stroke-width:2px;
  classDef source fill:#f8fafc,stroke:#64748b,color:#0f172a,stroke-width:2px;
  classDef external fill:#fdf2f8,stroke:#be185d,color:#0f172a,stroke-width:2px,stroke-dasharray:5 5;
  class AG,CI steering;
  class RM,UN,SC,DA contracts;
  class PM phasemap;
  class ST,SL,NX,PL,PB,AR run;
  class SP,PR source;
  class HE external;
