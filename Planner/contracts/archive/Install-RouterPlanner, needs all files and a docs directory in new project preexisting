# Install-RouterPlanner.ps1
#
# Copies the three router-planner contract files into a new project,
# creates the required directories, and updates the internal path
# references to match the destination.
#
# Usage:
#   .\Install-RouterPlanner.ps1 -SourceDir "C:\path\to\capex3\docs\router-planner-contracts" `
#                                -DestProjectRoot "C:\path\to\new-project"

param(
    [Parameter(Mandatory)]
    [string]$SourceDir,

    [Parameter(Mandatory)]
    [string]$DestProjectRoot
)

$ErrorActionPreference = "Stop"

# ─── PATHS ────────────────────────────────────────────────────────────────────

$ContractsDir     = Join-Path $DestProjectRoot "docs\router-planner-contracts"
$ArchitectureDir  = Join-Path $DestProjectRoot "docs\architecture-intake"

$Files = @(
    "codex-router-planner-unified.md",
    "codex-extraction-packet-schema-sexpr.md",
    "domain-spoke-architecture.md"
)

# ─── VERIFY SOURCE ────────────────────────────────────────────────────────────

Write-Host "`nVerifying source files..." -ForegroundColor Cyan

foreach ($file in $Files) {
    $sourcePath = Join-Path $SourceDir $file
    if (-not (Test-Path $sourcePath)) {
        Write-Error "Source file not found: $sourcePath"
        exit 1
    }
    Write-Host "  Found: $file"
}

# ─── VERIFY DESTINATION HAS DOCS ──────────────────────────────────────────────

$DocsDir = Join-Path $DestProjectRoot "docs"
if (-not (Test-Path $DocsDir)) {
    Write-Error "No docs folder found at: $DocsDir`nCreate a docs folder in the destination project first."
    exit 1
}

# ─── CREATE DIRECTORIES ───────────────────────────────────────────────────────

Write-Host "`nCreating directories..." -ForegroundColor Cyan

foreach ($dir in @($ContractsDir, $ArchitectureDir)) {
    if (-not (Test-Path $dir)) {
        New-Item -ItemType Directory -Path $dir | Out-Null
        Write-Host "  Created: $dir"
    } else {
        Write-Host "  Already exists: $dir"
    }
}

# ─── COPY FILES ───────────────────────────────────────────────────────────────

Write-Host "`nCopying contract files..." -ForegroundColor Cyan

foreach ($file in $Files) {
    $sourcePath = Join-Path $SourceDir $file
    $destPath   = Join-Path $ContractsDir $file
    Copy-Item -Path $sourcePath -Destination $destPath -Force
    Write-Host "  Copied: $file"
}

# ─── UPDATE INTERNAL PATH REFERENCES ─────────────────────────────────────────
# The unified contract has five hardcoded repo-relative paths.
# These are correct as-is since we're placing files in the same
# relative structure. Only needs changing if your new project
# uses a different docs layout.
#
# The paths in the unified contract are:
#   (self    "docs/router-planner-contracts/codex-router-planner-unified.md")
#   (schema  "docs/router-planner-contracts/codex-extraction-packet-schema-sexpr.md")
#   (arch    "docs/router-planner-contracts/domain-spoke-architecture.md")
#   (path    "docs/architecture-intake/<short-topic>-phase-map.md")
#
# Since we always create the same folder structure, these are valid
# without modification. Script confirms they are present.

Write-Host "`nVerifying internal path references in unified contract..." -ForegroundColor Cyan

$unifiedContract = Join-Path $ContractsDir "codex-router-planner-unified.md"
$content = Get-Content $unifiedContract -Raw

$expectedPaths = @(
    "docs/router-planner-contracts/codex-router-planner-unified.md",
    "docs/router-planner-contracts/codex-extraction-packet-schema-sexpr.md",
    "docs/router-planner-contracts/domain-spoke-architecture.md",
    "docs/architecture-intake/"
)

$allFound = $true
foreach ($path in $expectedPaths) {
    if ($content -match [regex]::Escape($path)) {
        Write-Host "  OK: $path"
    } else {
        Write-Warning "  NOT FOUND in contract: $path"
        $allFound = $false
    }
}

if (-not $allFound) {
    Write-Warning "Some path references were not found. Review the unified contract manually."
}

# ─── REMIND ABOUT MANUAL STEPS ────────────────────────────────────────────────

Write-Host "`n─────────────────────────────────────────────────────" -ForegroundColor Yellow
Write-Host "Done. Two manual steps remaining:" -ForegroundColor Yellow
Write-Host ""
Write-Host "  1. Edit AGENTS.md in the new project root." -ForegroundColor White
Write-Host "     Point the router contract reference to:" -ForegroundColor White
Write-Host "     docs/router-planner-contracts/codex-router-planner-unified.md" -ForegroundColor Cyan
Write-Host ""
Write-Host "  2. Edit docs/context-index.md in the new project." -ForegroundColor White
Write-Host "     Same change — update any reference to the old" -ForegroundColor White
Write-Host "     experimental router or planner filenames." -ForegroundColor White
Write-Host "─────────────────────────────────────────────────────" -ForegroundColor Yellow
Write-Host ""